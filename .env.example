# Copy to .env.local for local development (never commit real keys). All optional:
# without them the site works and shows the alerts panel as "coming soon".

# --- Website (public, safe to expose: these are baked into the built JS) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Server side only: GitHub Actions secrets + Supabase Edge Function secrets ---
# Never put these in a VITE_ variable or in the front end.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
RESEND_API_KEY=re_xxxxxxxxxxxx
# Public URL of the site, no trailing slash (used in email links and CORS)
SITE_URL=https://funded-abroad.pages.dev
# Who receives "New subscriber" notices, and whether to send them (true/false)
ADMIN_EMAIL=you@example.com
NOTIFY_ADMIN_ON_CONFIRM=true
# Sender. Until you verify a domain in Resend, use the test sender (it can only email your own Resend account address).
EMAIL_FROM=Funded Abroad <onboarding@resend.dev>
# Optional: any random string, used when hashing IPs for rate limiting
HASH_SALT=change-me-to-something-random
